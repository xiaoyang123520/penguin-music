<?xml version="1.0" encoding="UTF-8"?>
<!-- Launch4j config: wraps (embeds) the fat jar into Jussichords.exe
     (GUI header, no console). The user double-clicks the exe; the JRE is the
     bundled relative jre/ folder next to it. -->
<launch4jConfig>
  <dontWrapJar>false</dontWrapJar>
  <headerType>gui</headerType>
  <jar>jussichords-all.jar</jar>
  <outfile>Jussichords.exe</outfile>
  <errTitle>Jussichords</errTitle>
  <cmdLine></cmdLine>
  <chdir>.</chdir>
  <priority>normal</priority>
  <downloadUrl>https://adoptium.net/</downloadUrl>
  <supportUrl>https://github.com/easyTIDollar/jussichords</supportUrl>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <manifest></manifest>
  <icon></icon>
  <jre>
    <path>jre</path>
    <requiresJdk>false</requiresJdk>
    <requires64Bit>true</requires64Bit>
    <minVersion>17.0.0</minVersion>
    <maxHeapSize>1024</maxHeapSize>
    <initialHeapSize>128</initialHeapSize>
  </jre>
  <versionInfo>
    <fileVersion>2.4.5.0</fileVersion>
    <txtFileVersion>2.4.5</txtFileVersion>
    <fileDescription>Jussichords Desktop (Compose Multiplatform port of jussichords)</fileDescription>
    <copyright>jussichords contributors</copyright>
    <productVersion>2.4.5.0</productVersion>
    <txtProductVersion>2.4.5</txtProductVersion>
    <productName>Jussichords</productName>
    <internalName>jussichords</internalName>
    <originalFilename>Jussichords.exe</originalFilename>
  </versionInfo>
</launch4jConfig>
