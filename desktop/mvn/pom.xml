<?xml version="1.0" encoding="UTF-8"?>
<!-- 仅用于依赖解析（本机 Gradle daemon 无法存活，改走 Maven + kotlinc 手工管线）。
     解析出的 jar 拷到 target/cp 供 kotlinc 编译与最终 fat jar 组装。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.jussicodes</groupId>
    <artifactId>jussichords-desktop-deps</artifactId>
    <version>2.4.5</version>
    <packaging>jar</packaging>

    <repositories>
        <repository>
            <id>maven-central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>google-maven</id>
            <url>https://dl.google.com/dl/android/maven2</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Compose Desktop 1.8.0 -->
        <dependency>
            <groupId>org.jetbrains.compose.desktop</groupId>
            <artifactId>desktop-jvm</artifactId>
            <version>1.8.0</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.compose.desktop</groupId>
            <artifactId>desktop-jvm-linux-x64</artifactId>
            <version>1.8.0</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.compose.desktop</groupId>
            <artifactId>desktop-jvm-windows-x64</artifactId>
            <version>1.8.0</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.compose.material3</groupId>
            <artifactId>material3-desktop</artifactId>
            <version>1.8.0</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.compose.material</groupId>
            <artifactId>material-icons-extended-desktop</artifactId>
            <version>1.8.0</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.compose.components</groupId>
            <artifactId>components-resources-desktop</artifactId>
            <version>1.8.0</version>
        </dependency>

        <!-- JetBrains AndroidX 多平台构件 -->
        <dependency>
            <groupId>org.jetbrains.androidx.lifecycle</groupId>
            <artifactId>lifecycle-viewmodel-desktop</artifactId>
            <version>2.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.androidx.lifecycle</groupId>
            <artifactId>lifecycle-runtime-compose-desktop</artifactId>
            <version>2.9.6</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.androidx.navigation</groupId>
            <artifactId>navigation-compose-desktop</artifactId>
            <version>2.9.2</version>
        </dependency>

        <!-- Google AndroidX（JVM 变体） -->
        <dependency>
            <groupId>androidx.datastore</groupId>
            <artifactId>datastore-preferences-jvm</artifactId>
            <version>1.1.4</version>
        </dependency>
        <dependency>
            <groupId>androidx.datastore</groupId>
            <artifactId>datastore-jvm</artifactId>
            <version>1.1.4</version>
        </dependency>
        <dependency>
            <groupId>androidx.paging</groupId>
            <artifactId>paging-compose-desktop</artifactId>
            <version>3.3.6</version>
        </dependency>
        <dependency>
            <groupId>androidx.paging</groupId>
            <artifactId>paging-common-desktop</artifactId>
            <version>3.3.6</version>
        </dependency>

        <!-- Ktor 3.1.1 -->
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-client-core-jvm</artifactId>
            <version>3.1.1</version>
        </dependency>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-client-okhttp-jvm</artifactId>
            <version>3.1.1</version>
        </dependency>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-client-content-negotiation-jvm</artifactId>
            <version>3.1.1</version>
        </dependency>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-client-logging-jvm</artifactId>
            <version>3.1.1</version>
        </dependency>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-client-encoding-jvm</artifactId>
            <version>3.1.1</version>
        </dependency>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-serialization-kotlinx-json-jvm</artifactId>
            <version>3.1.1</version>
        </dependency>

        <!-- Coil 3.0.4 -->
        <dependency>
            <groupId>io.coil-kt.coil3</groupId>
            <artifactId>coil-compose-jvm</artifactId>
            <version>3.0.4</version>
        </dependency>
        <dependency>
            <groupId>io.coil-kt.coil3</groupId>
            <artifactId>coil-network-okhttp-jvm</artifactId>
            <version>3.0.4</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core</artifactId>
            <version>1.10.2</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-datetime-jvm</artifactId>
            <version>0.6.2</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-serialization-json</artifactId>
            <version>1.8.0</version>
        </dependency>

        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-kotlin-lite</artifactId>
            <version>4.29.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-javalite</artifactId>
            <version>4.29.1</version>
        </dependency>
        <dependency>
            <groupId>com.github.luben</groupId>
            <artifactId>zstd-jni</artifactId>
            <version>1.5.6-6</version>
        </dependency>
        <dependency>
            <groupId>sh.calvin.reorderable</groupId>
            <artifactId>reorderable-jvm</artifactId>
            <version>2.4.3</version>
        </dependency>
        <dependency>
            <groupId>javazoom</groupId>
            <artifactId>jlayer</artifactId>
            <version>1.0.1</version>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>1</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>2.0.21</version>
        </dependency>

        <!-- 打包：Launch4j（纯 jar + 配置即可在 Linux 生成 Windows exe） -->
        <dependency>
            <groupId>net.sf.launch4j</groupId>
            <artifactId>launch4j</artifactId>
            <version>3.50</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-deps</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/cp</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-protoc</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.google.protobuf</groupId>
                                    <artifactId>protoc</artifactId>
                                    <version>4.29.1</version>
                                    <classifier>linux-x86_64</classifier>
                                    <type>exe</type>
                                    <outputDirectory>${project.build.directory}/tools</outputDirectory>
                                    <destFileName>protoc</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
